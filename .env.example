# Ads load only on published articles at the production nicetrix.com hostname.
# The AdSense tag uses the site's published Google CMP; previews stay ad-free.
# Set true only after the AdSense site and CMP have been verified.
PUBLIC_ENABLE_ADS=false
# This controls preview robots and headers, not the production canonical URLs.
SITE_NOINDEX=false
# Match the existing branch selected as production in Cloudflare Pages.
PRODUCTION_BRANCH=main
