# Ads load only on the production nicetrix.com hostname AND after consent.
# Set true only when your AdSense/CMP configuration has been confirmed.
PUBLIC_ENABLE_ADS=false
# This controls preview robots and headers, not the production canonical URLs.
SITE_NOINDEX=false
# Match the existing branch selected as production in Cloudflare Pages.
PRODUCTION_BRANCH=design/antigravity-ui
